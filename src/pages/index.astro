---
import Base from '../layouts/Base.astro';
---
<Base title="Groot">
  <main>
    <h1>Welcome</h1>
    <nav>
      <section>
        <h2>Tools</h2>
        <ul>
          <li><a href="/tools/samtalehjelp/index.html">Samtalehjelp</a></li>
        </ul>
      </section>
      <section>
        <h2>Elsewhere</h2>
        <ul>
          <li><a href="/foggy/">Enter the forest</a></li>
          <li>
            <a href="https://www.cameronsworld.net/" target="_blank" rel="noopener noreferrer">
              Visit an awesome page
            </a>
          </li>
          <li><a href="/blog/">Notes to self</a></li>
        </ul>
      </section>
    </nav>
  </main>
</Base>

<style>
  main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 100vh;
    width: 100%;
    padding: 0 6rem;
    gap: 4rem;
  }
  h1 {
    font-size: 4rem;
    color: var(--primary);
    letter-spacing: 0.05em;
    line-height: 1.1;
    margin: 0;
  }
  nav {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  h2 {
    font-size: 0.85rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--on-surface-variant);
    margin: 0 0 1.25rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  a {
    font-size: 1.15rem;
    font-weight: 300;
    color: var(--primary-container);
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 500ms ease-out, letter-spacing 500ms ease-out;
  }
  a:hover {
    color: var(--primary);
    letter-spacing: 0.05em;
  }
  @media (max-width: 640px) {
    main {
      grid-template-columns: 1fr;
      padding: 4rem 2.5rem;
      gap: 3rem;
    }
  }
</style>
